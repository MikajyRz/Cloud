package com.cloud.web.sync;

import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/sync")
public class SyncController {

    private final FirebaseSyncService syncService;

    public SyncController(FirebaseSyncService syncService) {
        this.syncService = syncService;
    }

    /**
     * PUSH utilisateurs vers Firebase
     */
    @PostMapping("/users/push")
    @PreAuthorize("hasRole('MANAGER')")
    public ResponseEntity<Map<String, Object>> pushUsers() {
        try {
            int count = syncService.pushUsersToFirebase();
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("count", count);
            response.put("message", count + " utilisateur(s) envoyé(s) vers Firebase");
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            Map<String, Object> error = new HashMap<>();
            error.put("success", false);
            error.put("error", e.getMessage());
            return ResponseEntity.status(500).body(error);
        }
    }

    /**
     * PULL utilisateurs depuis Firebase
     */
    @PostMapping("/users/pull")
    @PreAuthorize("hasRole('MANAGER')")
    public ResponseEntity<Map<String, Object>> pullUsers() {
        try {
            int count = syncService.pullUsersFromFirebase();
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("count", count);
            response.put("message", count + " utilisateur(s) importé(s) depuis Firebase");
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            Map<String, Object> error = new HashMap<>();
            error.put("success", false);
            error.put("error", e.getMessage());
            return ResponseEntity.status(500).body(error);
        }
    }

    /**
     * PUSH signalements vers Firebase
     */
    @PostMapping("/signalements/push")
    @PreAuthorize("hasRole('MANAGER')")
    public ResponseEntity<Map<String, Object>> pushSignalements() {
        try {
            int count = syncService.pushSignalementsToFirebase();
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("count", count);
            response.put("message", count + " signalement(s) envoyé(s) vers Firebase");
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            Map<String, Object> error = new HashMap<>();
            error.put("success", false);
            error.put("error", e.getMessage());
            return ResponseEntity.status(500).body(error);
        }
    }

    /**
     * PULL signalements depuis Firebase
     */
    @PostMapping("/signalements/pull")
    @PreAuthorize("hasRole('MANAGER')")
    public ResponseEntity<Map<String, Object>> pullSignalements() {
        try {
            int count = syncService.pullSignalementsFromFirebase();
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("count", count);
            response.put("message", count + " signalement(s) importé(s) depuis Firebase");
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            Map<String, Object> error = new HashMap<>();
            error.put("success", false);
            error.put("error", e.getMessage());
            return ResponseEntity.status(500).body(error);
        }
    }

    /**
     * Historique de synchronisation
     */
    @GetMapping("/history/{type}")
    @PreAuthorize("hasRole('MANAGER')")
    public ResponseEntity<List<FirebaseSync>> getSyncHistory(@PathVariable String type) {
        List<FirebaseSync> history = syncService.getSyncHistory(type.toUpperCase());
        return ResponseEntity.ok(history);
    }
}
